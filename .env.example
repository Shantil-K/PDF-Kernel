# Copy to .env (same folder you run from) or to your user config dir:
#   Linux:   ~/.config/pdf-kernel/.env
#   macOS:   ~/Library/Application Support/pdf-kernel/.env
#   Windows: %APPDATA%\pdf-kernel\.env
# Real environment variables override these.

# ---- Groq (https://console.groq.com/keys) ----
# Comma-separated; keys are used in rotation.
GROQ_API_KEYS=gsk_key_one,gsk_key_two
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google AI Studio / Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEYS=AIza_key_one,AIza_key_two
GEMINI_MODEL=gemini-2.5-flash

# ---- LM Studio (local, no key) ----
# Start the server in LM Studio (Developer tab) and load a model.
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Leave empty to use whichever model is loaded.
LMSTUDIO_MODEL=

# Which provider to try first; the rest are fallbacks.
PDFK_PROVIDER_ORDER=groq,gemini,lmstudio

# ---- Tuning (optional) ----
# Max document characters per request (~4 chars per token). Groq's free tier
# has low tokens-per-minute limits, so keep this modest there.
# PDFK_MAX_CONTEXT_CHARS=16000
# PDFK_CHUNK_CHARS=2000
# PDFK_CHUNK_OVERLAP=200
# PDFK_CONCURRENCY=3
# PDFK_KEY_COOLDOWN_SECS=60
# PDFK_REQUEST_TIMEOUT_SECS=120

# ---- HTTP server (only for `pdfk serve`) ----
# PDFK_SERVER_TOKEN=change-me

# ---- Google sign-in for the app (see docs/GOOGLE_SETUP.md) ----
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
